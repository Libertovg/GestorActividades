<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #f4f6fa;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controladores.FXMLController">

 <top>
            <VBox>
                     <MenuBar>
                  <menus>
                     <Menu text="Archivo">
                        <items>
                           <SeparatorMenuItem />
                           <MenuItem fx:id="btnsalir" onAction="#onsalir" text="Salir" />
                        </items>
                     </Menu>
               
                     <Menu text="Ayuda">
                        <items>
                           <MenuItem onAction="#onacercade" text="Acerca de" />
                        </items>
                     </Menu>
                  </menus>
               </MenuBar>
               <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #dde3ee; -fx-border-width: 0 0 1 0;">
                  <padding>
                     <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
                  </padding>
                  <VBox spacing="2.0">
                     <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Gestor de Actividades" />
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7a90;" text="Organiza, descubre e inscríbete en actividades del centro" />
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER_RIGHT" spacing="2.0">
                     <Label style="-fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Liberto Valero" />
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7a90;" text="Alumno(DAM2)" />
                  </VBox>
               </HBox>
            </VBox>
         </top>

   <left>
      <VBox prefWidth="220.0" spacing="6.0" style="-fx-background-color: #eef1f6; -fx-border-color: #dde3ee; -fx-border-width: 0 1 0 0;">
         <padding>
            <Insets bottom="20.0" left="12.0" right="12.0" top="20.0" />
         </padding>
         <Button fx:id="btninicio" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#irinicio" style="-fx-background-color: #2f7de1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Inicio" />
         <Button fx:id="btninscripcion" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#irinscripcion" style="-fx-background-color: transparent; -fx-text-fill: #33415c; -fx-background-radius: 8;" text="Inscripción" />
         <Button fx:id="btnactividades" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#iractividades" style="-fx-background-color: transparent; -fx-text-fill: #33415c; -fx-background-radius: 8;" text="Actividades" />
         <Button fx:id="btnconfiguracion" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#irconfiguracion" style="-fx-background-color: transparent; -fx-text-fill: #33415c; -fx-background-radius: 8;" text="Configuración" />
      </VBox>
   </left>

   <center>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>

         <!-- Bienvenida -->
         <VBox spacing="4.0" style="-fx-background-color: #dfeafb; -fx-background-radius: 10; -fx-padding: 18;">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Bienvenido al panel principal" />
            <Label style="-fx-text-fill: #4a5a73;" text="Consulta las actividades, tus inscripciones y las novedades del centro." />
         </VBox>

         <HBox spacing="16.0">
            <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #cfe0fb; -fx-border-radius: 10; -fx-padding: 16;" HBox.hgrow="ALWAYS">
               <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2f7de1;" text="12" />
               <Label style="-fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Actividades disponibles" />
               <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7a90;" text="Abiertas para inscripción" wrapText="true" />
            </VBox>
            <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #c9ecd9; -fx-border-radius: 10; -fx-padding: 16;" HBox.hgrow="ALWAYS">
               <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f9d5c;" text="48" />
               <Label style="-fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Inscritos" />
               <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7a90;" text="Estudiantes apuntados" wrapText="true" />
            </VBox>
            <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #f7e2c4; -fx-border-radius: 10; -fx-padding: 16;" HBox.hgrow="ALWAYS">
               <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #d9822b;" text="5" />
               <Label style="-fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Eventos esta semana" />
               <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7a90;" text="Próximos eventos" wrapText="true" />
            </VBox>
            <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #f5cfcf; -fx-border-radius: 10; -fx-padding: 16;" HBox.hgrow="ALWAYS">
               <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #c93c3c;" text="3" />
               <Label style="-fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Avisos" />
               <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7a90;" text="Nuevas notificaciones" wrapText="true" />
            </VBox>
         </HBox>

         <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #dde3ee; -fx-border-radius: 10; -fx-padding: 16;">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Avisos recientes" />
            <Label text="• Cambio de aula en la charla de ciberseguridad" />
            <Label text="• Abierto el plazo de inscripción" />
            <Label text="• Nueva actividad: Taller de JavaFX" />
            <Label text="• Recordatorio: entrega de proyectos" />
            <Button alignment="CENTER" style="-fx-background-color: #eef1f6; -fx-text-fill: #1f3a5f; -fx-background-radius: 6;" text="Ver todos" />
         </VBox>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #dde3ee; -fx-border-width: 1 0 0 0;">
         <padding>
            <Insets bottom="8.0" left="24.0" right="24.0" top="8.0" />
         </padding>
         <Label style="-fx-font-size: 10px; -fx-text-fill: #6b7a90;" text="Gestor de Actividades · v1.0 | IES José Luis Martínez Palomo" />
         <Region HBox.hgrow="ALWAYS" />
         <Label style="-fx-font-size: 10px; -fx-text-fill: #6b7a90;" text="DAM2 | Desarrollo de Interfaces" />
      </HBox>
   </bottom>
</BorderPane>
